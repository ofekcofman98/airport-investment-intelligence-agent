{
  "name": "airport-investment-intelligence-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI agent for airport investment research: congestion, capacity, and unmet-demand analysis over a static BTS snapshot.",
  "scripts": {
    "build:data": "tsx src/data/build.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "cli": "tsx --env-file-if-exists=.env src/interface/cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
